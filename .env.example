# ==============================================================================
# Movie Ticket Bot - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env   (or copy .env.example .env on Windows)
# 2. Fill in your Telegram Bot credentials below.
# 3. DO NOT commit your .env file to Git! (.env is listed in .gitignore)
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (your numeric user or group ID, obtained from @userinfobot)
TELEGRAM_CHAT_ID=your_numeric_chat_id_here
